# --- Supabase (project settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com) ---
ANTHROPIC_API_KEY=
# Model for CV parsing, research, letters and critique. Defaults to claude-opus-5.
ANTHROPIC_MODEL=
# Model for high-volume background work (company summaries, domain lookups,
# reading pasted job pages). Defaults to ANTHROPIC_MODEL. Set to
# claude-haiku-4-5 to cut enrichment cost ~5x without touching letter quality.
ANTHROPIC_MODEL_BULK=

# --- Voyage AI embeddings (dash.voyageai.com) — 1024-dim vectors ---
VOYAGE_API_KEY=

# --- Job sources ---
# https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# https://www.reed.co.uk/developers
REED_API_KEY=
# https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=
# Optional, billed per request — only for deliberate local searches
GOOGLE_PLACES_API_KEY=

# --- Cron protection (any random string; Vercel sends it automatically) ---
CRON_SECRET=

# --- Scraper identity ---
SCRAPER_USER_AGENT="InternshipEngine/0.1 (personal project; contact: you@example.com)"
